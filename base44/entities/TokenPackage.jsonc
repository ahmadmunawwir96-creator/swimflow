{
  "properties": {
    "name": {
      "type": "string",
      "description": "Package name"
    },
    "token_count": {
      "type": "number",
      "description": "Number of tokens in the package"
    },
    "price": {
      "type": "number",
      "description": "Price of the package"
    },
    "currency": {
      "type": "string",
      "description": "Currency code",
      "default": "MYR"
    },
    "description": {
      "type": "string",
      "description": "Package description"
    },
    "is_active": {
      "type": "boolean",
      "description": "Whether the package is active and purchasable",
      "default": true
    }
  },
  "required": [
    "name",
    "token_count",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "TokenPackage",
  "type": "object"
}