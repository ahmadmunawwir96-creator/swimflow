{
  "name": "Location",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Venue name \u2014 the physical pool where classes take place (academy pool, condominium pool, external pool). Not a business branch."
    },
    "branch_id": {
      "type": "string",
      "description": "Reference to the Branch this venue belongs to. A Branch may have several venues. Required: the venue's branch is what grants an Admin access to its classes."
    },
    "address": {
      "type": "string",
      "description": "Optional address or short venue description shown to staff and members."
    },
    "notes": {
      "type": "string",
      "description": "Optional internal notes about the venue (access, parking, entry instructions). Not shown to members."
    },
    "is_active": {
      "type": "boolean",
      "description": "Whether the venue can be used for new classes. Venues are deactivated, never deleted, so historical classes keep their venue.",
      "default": true
    }
  },
  "required": [
    "name",
    "branch_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}