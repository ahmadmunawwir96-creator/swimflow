{
  "properties": {
    "name": {
      "type": "string",
      "description": "Location/branch name (e.g. academy pool name)"
    },
    "address": {
      "type": "string",
      "description": "Location address"
    },
    "is_active": {
      "type": "boolean",
      "description": "Whether the location is active",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "Location",
  "type": "object"
}