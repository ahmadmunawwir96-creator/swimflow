{
  "properties": {
    "name": {
      "type": "string",
      "description": "Location name \u2014 the physical venue/pool (academy pool, external pool, condominium pool). Not a business branch."
    },
    "branch_id": {
      "type": "string",
      "description": "Reference to the Branch this venue belongs to. A Branch may have several Locations. Optional only so existing locations can be mapped during migration; new locations must be given a branch."
    },
    "address": {
      "type": "string",
      "description": "Location address"
    },
    "is_active": {
      "type": "boolean",
      "description": "Whether the location is active",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "Location",
  "type": "object"
}