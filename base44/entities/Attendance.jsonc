{
  "properties": {
    "student_id": {
      "type": "string",
      "description": "Reference to the Student whose attendance is recorded"
    },
    "class_id": {
      "type": "string",
      "description": "Reference to the Class this attendance is for"
    },
    "booking_id": {
      "type": "string",
      "description": "Reference to the Booking this attendance is linked to, if any"
    },
    "coach_id": {
      "type": "string",
      "description": "Reference to the coach User who recorded attendance"
    },
    "account_id": {
      "type": "string",
      "description": "Optional reference to the owning User account (self-managed student or parent/guardian), to support secure owner read access to attendance"
    },
    "attendance_status": {
      "type": "string",
      "description": "Attendance status",
      "enum": [
        "present",
        "absent",
        "late",
        "excused"
      ]
    },
    "check_in_time": {
      "type": "string",
      "format": "date-time",
      "description": "Check-in time (supports manual or future QR-code check-in)"
    },
    "check_out_time": {
      "type": "string",
      "format": "date-time",
      "description": "Check-out time, if applicable"
    },
    "notes": {
      "type": "string",
      "description": "Notes about the attendance"
    }
  },
  "required": [
    "student_id",
    "class_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.account_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "Attendance",
  "type": "object"
}