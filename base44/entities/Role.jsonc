{
  "properties": {
    "name": {
      "type": "string",
      "description": "Role name",
      "enum": [
        "admin",
        "coach",
        "parent",
        "student"
      ]
    },
    "description": {
      "type": "string",
      "description": "Role description"
    },
    "is_system": {
      "type": "boolean",
      "description": "Whether this is a built-in system role that cannot be deleted",
      "default": true
    },
    "is_active": {
      "type": "boolean",
      "description": "Whether this role is active and assignable",
      "default": true
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "Role",
  "type": "object"
}