{
  "properties": {
    "student_id": {
      "type": "string",
      "description": "Reference to the Student whose token balance this transaction affects"
    },
    "parent_account_id": {
      "type": "string",
      "description": "Reference to the parent User account associated with the transaction"
    },
    "transaction_type": {
      "type": "string",
      "description": "Transaction type",
      "enum": [
        "purchase",
        "use",
        "refund",
        "adjustment",
        "expiry"
      ]
    },
    "amount": {
      "type": "number",
      "description": "Token amount. Positive for additions (purchase, refund), negative for deductions (use, expiry). The student balance is the sum of all amounts."
    },
    "balance_after": {
      "type": "number",
      "description": "Student token balance immediately after this transaction. Convenience field only, never authoritative; the ledger (sum of all amounts) is the source of truth."
    },
    "payment_id": {
      "type": "string",
      "description": "Reference to the Payment that triggered this purchase (for type=purchase)"
    },
    "booking_id": {
      "type": "string",
      "description": "Reference to the Booking that consumed this token, or whose token is being restored on refund. Retained so refunds and usage history link back to a booking."
    },
    "token_package_id": {
      "type": "string",
      "description": "Reference to the TokenPackage purchased (for type=purchase)"
    },
    "related_transaction_id": {
      "type": "string",
      "description": "Optional reference to the original TokenTransaction being reversed or adjusted (for refund, expiry, or manual adjustment audit trail)"
    },
    "expiry_date": {
      "type": "string",
      "format": "date",
      "description": "Token expiry date, if applicable"
    },
    "notes": {
      "type": "string",
      "description": "Notes about this transaction"
    }
  },
  "required": [
    "student_id",
    "transaction_type",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.parent_account_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "TokenTransaction",
  "type": "object"
}