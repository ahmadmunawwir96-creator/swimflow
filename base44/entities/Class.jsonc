{
  "name": "Class",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Readable label shown to staff and members, e.g. 'Beginner class'. The backend supplies a default derived from the level when the admin leaves it blank, so this stays required."
    },
    "class_date": {
      "type": "string",
      "format": "date",
      "description": "Calendar date of this single scheduled session (YYYY-MM-DD). One record represents one session; there is no recurrence engine."
    },
    "start_time": {
      "type": "string",
      "description": "Start time in 24-hour HH:MM, academy local time."
    },
    "end_time": {
      "type": "string",
      "description": "End time in 24-hour HH:MM. Required in practice because coach overlap detection depends on it."
    },
    "location_id": {
      "type": "string",
      "description": "Physical venue/pool where the session takes place. The session's Branch is derived from this venue server-side, never supplied by the browser. Several sessions may share the venue at the same time (one per coach on duty)."
    },
    "branch_id": {
      "type": "string",
      "description": "Server-derived snapshot of the venue's Branch at write time (authorization boundary + display). Never accepted from the client."
    },
    "coach_id": {
      "type": "string",
      "description": "Coach User taking the session. Required: every real scheduled class has a coach, validated server-side to hold an active Coach role, and a coach may not be in two overlapping sessions."
    },
    "class_group_id": {
      "type": "string",
      "description": "Optional link to the ClassGroup this session was generated from. Historical only: editing the group never rewrites an existing session."
    },
    "skill_level": {
      "type": "string",
      "description": "Level the session is aimed at. Deliberately the same values as Student.swimming_level so a swimmer's level maps onto classes without translation.",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "max_capacity": {
      "type": "number",
      "description": "Maximum swimmers for the session. Stored only in this phase; nothing is reserved or deducted because booking does not exist yet."
    },
    "status": {
      "type": "string",
      "description": "Session state. 'cancelled' records are retained, never deleted, so later token/attendance/reporting logic can still see them.",
      "enum": [
        "scheduled",
        "completed",
        "cancelled"
      ],
      "default": "scheduled"
    },
    "notes": {
      "type": "string",
      "description": "Optional internal notes for staff. Not shown to members."
    },
    "cancellation_type": {
      "type": "string",
      "description": "Why the session was cancelled. 'normal' is an ordinary one-off cancellation; 'academy' is a closure decided by the academy itself. Any further detail belongs in cancellation_reason, which stays free text.",
      "enum": [
        "normal",
        "academy"
      ]
    },
    "cancellation_reason": {
      "type": "string",
      "description": "Optional free-text reason recorded with the cancellation."
    },
    "cancelled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the session was marked cancelled (cleared if the cancellation is reversed)."
    },
    "cancelled_by": {
      "type": "string",
      "description": "User who marked the session cancelled."
    }
  },
  "required": [
    "name",
    "class_date",
    "location_id",
    "coach_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}