{
  "properties": {
    "account_id": {
      "type": "string",
      "description": "Reference to the owning User account. For a self-managed student this is the swimmer themselves; for a parent-managed swimmer this is the parent/guardian."
    },
    "ownership_type": {
      "type": "string",
      "description": "Whether the owning account is the swimmer themselves or a parent/guardian managing on their behalf",
      "enum": [
        "self",
        "dependent"
      ],
      "default": "dependent"
    },
    "relationship": {
      "type": "string",
      "description": "Relationship of the owning account to the swimmer (for dependants)",
      "enum": [
        "self",
        "child",
        "dependant",
        "ward",
        "sibling"
      ]
    },
    "full_name": {
      "type": "string",
      "description": "Student full name"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date",
      "description": "Student date of birth"
    },
    "gender": {
      "type": "string",
      "description": "Gender",
      "enum": [
        "male",
        "female",
        "other"
      ]
    },
    "swimming_level": {
      "type": "string",
      "description": "Swimming level",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ]
    },
    "skill_progression": {
      "type": "string",
      "description": "Current skill/progression level notes"
    },
    "medical_notes": {
      "type": "string",
      "description": "Medical/safety notes"
    },
    "emergency_contact_name": {
      "type": "string",
      "description": "Emergency contact name"
    },
    "emergency_contact_phone": {
      "type": "string",
      "description": "Emergency contact phone"
    },
    "status": {
      "type": "string",
      "description": "Student status",
      "enum": [
        "active",
        "inactive",
        "trial",
        "left"
      ],
      "default": "active"
    },
    "date_joined": {
      "type": "string",
      "format": "date",
      "description": "Date the student joined"
    },
    "date_left": {
      "type": "string",
      "format": "date",
      "description": "Date the student left"
    },
    "reason_for_leaving": {
      "type": "string",
      "description": "Reason for leaving"
    },
    "consent_status": {
      "type": "string",
      "description": "Guardian consent status for self-managed minors. 'not_required' for dependants (parent is the consenting party) or adults. Registration is never blocked by age; booking/payment for pending/refused is disabled by backend policy only.",
      "enum": [
        "not_required",
        "pending",
        "given",
        "refused"
      ],
      "default": "not_required"
    },
    "consent_guardian_name": {
      "type": "string",
      "description": "Name of the guardian who gave consent, for self-managed minors (no separate guardian account required)"
    },
    "consent_guardian_phone": {
      "type": "string",
      "description": "Phone of the guardian who gave consent, for self-managed minors"
    },
    "consent_date": {
      "type": "string",
      "format": "date",
      "description": "Date consent was recorded"
    }
  },
  "required": [
    "account_id",
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.account_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  },
  "name": "Student",
  "type": "object"
}